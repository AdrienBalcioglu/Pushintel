# Server
PORT=3000
NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://pushintel:password@localhost:5432/pushintel

# Redis
REDIS_URL=redis://localhost:6379

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# APNs iOS
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=./certs/apns.p8
APNS_PRODUCTION=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Analytics
DISCORD_WEBHOOK_URL=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
