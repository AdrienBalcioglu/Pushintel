{
  "name": "pushintel",
  "version": "1.0.0",
  "description": "Multi-platform push notification service with MCP server for Claude Desktop integration",
  "keywords": ["push-notifications", "apns", "fcm", "expo", "mcp", "bullmq", "analytics"],
  "author": "Adrien Balcioglu",
  "license": "ISC",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdrienBalcioglu/Pushintel.git"
  },
  "bugs": {
    "url": "https://github.com/AdrienBalcioglu/Pushintel/issues"
  },
  "homepage": "https://github.com/AdrienBalcioglu/Pushintel#readme",
  "scripts": {
    "build": "prisma generate && tsup src/index.ts src/queue/workers/push.worker.ts src/queue/workers/analytics.worker.ts --format cjs --clean --dts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "apn": "^2.2.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.10",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^5.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/apn": "^0.0.31",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}